---
import AdminIcon from './AdminIcon.astro';
import AdminSiteSocialSection from './AdminSiteSocialSection.astro';
import {
  ADMIN_FILINGS_NUMBER_MAX_LENGTH,
  ADMIN_FILINGS_SCOPE_DEFAULT,
  ADMIN_FILINGS_SCOPE_OPTIONS,
  ADMIN_OVERVIEW_HIDDEN_MESSAGE_MAX_LENGTH,
  ADMIN_SITE_PAGE_GAP_DEFAULT,
  ADMIN_SITE_PAGE_GAP_HINT,
  ADMIN_SITE_PAGE_GAP_MAX,
  ADMIN_SITE_PAGE_GAP_MIN,
  ADMIN_SITE_TITLE_PERCENT_DEFAULT,
  ADMIN_SITE_TITLE_PERCENT_MAX,
  ADMIN_SITE_TITLE_PERCENT_MIN
} from '../../lib/admin-console/theme-shared';

interface Props {
  footerStartYearMin: number;
  footerStartYearMax: number;
  socialCustomLimit: number;
}

const { footerStartYearMin, footerStartYearMax, socialCustomLimit } = Astro.props;

// 站点图标：标签页图标与触摸图标各一个槽位，只有文案与 data 钩子不同。
const faviconSlots = [
  { key: 'png', label: '标签页图标', uploadLabel: '上传标签页图标', clearLabel: '恢复标签页图标为主题默认' },
  { key: 'appleTouchIcon', label: '触摸图标', uploadLabel: '上传触摸图标', clearLabel: '恢复触摸图标为主题默认' }
];

// 备案信息：两个备案号另有长度上限与占位文案，两个链接可留空。
type FilingField = {
  key: string;
  label: string;
  hint: string;
  maxLength?: number;
  placeholder?: string;
};
const filingFields: FilingField[] = [
  {
    key: 'icp-number',
    label: '工信部备案号',
    hint: '（链接到工信部备案系统）',
    maxLength: ADMIN_FILINGS_NUMBER_MAX_LENGTH,
    placeholder: '皖ICP备12345678号-1'
  },
  {
    key: 'police-number',
    label: '公安备案号',
    hint: '（链接编号自动取号内数字）',
    maxLength: ADMIN_FILINGS_NUMBER_MAX_LENGTH,
    placeholder: '皖公网安备12345678901234号'
  },
  { key: 'icp-link', label: '工信部备案链接', hint: '（留空用备案系统首页）' },
  { key: 'police-link', label: '公安备案链接', hint: '（可选，平台给出的地址优先）' }
];
---

<fieldset class="admin-group">
  <legend class="admin-group__legend">
    <AdminIcon name="admin-site" class="admin-group__legend-icon" size={14} />
    <span class="admin-group__legend-copy">
      <span class="admin-group__legend-zh">站点设置</span>
      <span class="admin-group__legend-en">Site</span>
    </span>
  </legend>
  <div class="admin-grid">
    <label class="admin-field">
      <span class="admin-label">
        <span class="admin-label__main">站点标题</span>
        <span class="admin-label__hint">（用于浏览器标题 / RSS / 分享）</span>
      </span>
      <input class="admin-field__control" id="site-title" type="text" autocomplete="off" />
    </label>
    <label class="admin-field">
      <span class="admin-label">
        <span class="admin-label__main">站点语言</span>
        <span class="admin-label__hint">（默认值为 zh-CN）</span>
      </span>
      <input class="admin-field__control" id="site-default-locale" type="text" autocomplete="off" />
    </label>
    <label class="admin-field admin-field--full">
      <span class="admin-label">
        <span class="admin-label__main">默认 SEO 描述</span>
        <span class="admin-label__hint">（用于搜索结果和分享摘要）</span>
      </span>
      <textarea class="admin-field__control admin-field__control--singleline-textarea" id="site-description" rows="1"></textarea>
    </label>
    {/*
      页脚信息在上，新增的窄屏站点标题宽度与页面外缘间隙在下。四项都是 .admin-grid 的直接子项，
      与上方的站点标题、站点语言共用同一套两列网格，列与列对齐；页脚预览跨两列。
    */}
    <label class="admin-field">
      <span class="admin-label">
        <span class="admin-label__main">页脚年份</span>
        <span class="admin-label__hint">（结束年份自动拾取当前年）</span>
      </span>
      <span class="admin-year-range">
        <input
          class="admin-field__control"
          id="site-footer-start-year"
          type="number"
          min={footerStartYearMin}
          max={footerStartYearMax}
          step="1"
          inputmode="numeric"
          placeholder={String(footerStartYearMax)}
          aria-describedby="site-footer-preview"
        />
        <span class="admin-year-range__sep" aria-hidden="true">-</span>
        <input
          class="admin-field__control admin-year-range__readonly"
          name="site-footer-current-year-display"
          type="text"
          value={String(footerStartYearMax)}
          readonly
          tabindex="-1"
          aria-label="当前年份（自动）"
        />
        <label class="admin-year-range__toggle">
          <input id="site-footer-show-current-year" type="checkbox" checked />
          <span class="sr-only">显示当前年</span>
        </label>
      </span>
    </label>
    <label class="admin-field">
      <span class="admin-label">
        <span class="admin-label__main">页脚版权文案</span>
      </span>
      <input class="admin-field__control" id="site-footer-copyright" type="text" autocomplete="off" aria-describedby="site-footer-preview" />
    </label>
    <div class="admin-field admin-field--full">
      <p id="site-footer-preview" class="admin-help">
        页脚预览：<code id="site-footer-preview-value">© {footerStartYearMax} Whono · Theme Demo · by cxro</code>
      </p>
    </div>
    <label class="admin-field">
      <span class="admin-label">
        <span class="admin-label__main">窄屏站点标题宽度</span>
        <span class="admin-label__hint">（%，默认 {ADMIN_SITE_TITLE_PERCENT_DEFAULT}）</span>
      </span>
      <input
        class="admin-field__control admin-field__control--percent"
        id="site-title-max-percent"
        type="number"
        min={ADMIN_SITE_TITLE_PERCENT_MIN}
        max={ADMIN_SITE_TITLE_PERCENT_MAX}
        step="1"
        inputmode="numeric"
        placeholder={String(ADMIN_SITE_TITLE_PERCENT_DEFAULT)}
      />
    </label>
    <label class="admin-field">
      <span class="admin-label">
        <span class="admin-label__main">页面外缘间隙</span>
        <span class="admin-label__hint">{ADMIN_SITE_PAGE_GAP_HINT}</span>
      </span>
      <input
        class="admin-field__control admin-field__control--page-gap"
        id="site-page-gap-px"
        type="number"
        min={ADMIN_SITE_PAGE_GAP_MIN}
        max={ADMIN_SITE_PAGE_GAP_MAX}
        step="1"
        inputmode="numeric"
        placeholder={String(ADMIN_SITE_PAGE_GAP_DEFAULT)}
      />
    </label>
    <div class="admin-field admin-field--full">
      <div class="admin-label admin-label--split">
        <span class="admin-label__copy">
          <label class="admin-label__main" for="site-admin-overview-hidden-message">
            <code>/admin/</code> Overview 公开访问（不收录）
          </label>
          <span class="admin-label__hint">（构建后生效；关闭公开时，该页仅显示下方文字）</span>
        </span>
        <label class="admin-label__toggle" for="site-admin-overview-public-visible">
          <input id="site-admin-overview-public-visible" type="checkbox" checked />
          <span>公开</span>
        </label>
      </div>
      <input
        class="admin-field__control"
        id="site-admin-overview-hidden-message"
        type="text"
        maxlength={ADMIN_OVERVIEW_HIDDEN_MESSAGE_MAX_LENGTH}
        autocomplete="off"
        disabled
      />
    </div>
    <div class="admin-field admin-field--full">
      <span class="admin-label">
        <span class="admin-label__main">站点图标</span>
        <span class="admin-label__hint">（浏览器标签页 / 移动端触摸图标；构建后生效）</span>
      </span>
      <input id="site-favicon-svg" type="hidden" />
      <input id="site-favicon-png" type="hidden" />
      <input id="site-favicon-apple-touch-icon" type="hidden" />
      <div class="admin-favicon-line">
        {faviconSlots.map((slot, index) => (
          <>
            {index > 0 ? <span class="admin-favicon-line__divider" aria-hidden="true"></span> : null}
            <div class="admin-favicon-slot" data-favicon-slot={slot.key}>
              <span class="admin-favicon-slot__preview" data-favicon-preview={slot.key}>
                <img alt="" loading="lazy" decoding="async" data-favicon-preview-img={slot.key} />
              </span>
              <span class="admin-favicon-slot__label">{slot.label}</span>
              <button class="admin-btn admin-btn--ghost admin-btn--compact" type="button" data-favicon-upload={slot.key} aria-label={slot.uploadLabel}>上传</button>
              <button class="admin-btn admin-btn--ghost admin-btn--compact" type="button" data-favicon-clear={slot.key} aria-label={slot.clearLabel}>恢复默认</button>
            </div>
          </>
        ))}
      </div>
      {faviconSlots.map((slot) => (
        <input type="file" accept="image/png" hidden data-favicon-file={slot.key} />
      ))}
      <p class="admin-help">
        建议上传 256x256 的正方形 PNG（边长 16-512px，不超过 256KB）；SVG 图标请直接替换 <code>public/favicon.svg</code>。
      </p>
    </div>
  </div>

  <div class="admin-subgroup">
    <p class="admin-subtitle">
      <span class="admin-subtitle__main">备案信息</span>
      <span class="admin-subtitle__hint">（国内建站必填，显示在页脚版权之上）</span>
    </p>
    <div class="admin-grid">
      {filingFields.map((field) => (
        <label class="admin-field">
          <span class="admin-label">
            <span class="admin-label__main">{field.label}</span>
            <span class="admin-label__hint">{field.hint}</span>
          </span>
          <input
            class="admin-field__control"
            id={`site-filings-${field.key}`}
            type="text"
            maxlength={field.maxLength ?? undefined}
            autocomplete="off"
            placeholder={field.placeholder ?? undefined}
          />
        </label>
      ))}
      <label class="admin-field">
        <span class="admin-label admin-label--filings-icon">
          <span
            class="admin-filings-icon__preview"
            id="filings-icon-preview"
            data-state="empty"
            aria-hidden="true"
          >
            <img alt="" loading="lazy" decoding="async" data-filings-icon-preview-img hidden />
          </span>
          <span class="admin-label__main">公安备案图标</span>
          <span class="admin-label__hint">（相对路径或 https；留空只显示文字）</span>
        </span>
        <input
          class="admin-field__control"
          id="site-filings-police-icon"
          type="text"
          autocomplete="off"
          placeholder="images/beian.png"
        />
      </label>
      <label class="admin-field">
        <span class="admin-label">
          <span class="admin-label__main">备案信息显示范围</span>
          <span class="admin-label__hint">（按规定只需在站点根目录可被检索到）</span>
        </span>
        <select class="admin-field__control" id="site-filings-scope">
          {ADMIN_FILINGS_SCOPE_OPTIONS.map((option) => (
            <option value={option.id} selected={option.id === ADMIN_FILINGS_SCOPE_DEFAULT}>{option.label}</option>
          ))}
        </select>
      </label>
      <div class="admin-field admin-field--full">
        <p class="admin-help">
          预览：<code id="filings-preview-value">皖ICP备12345678号-1 · 皖公网安备12345678901234号</code>
        </p>
      </div>
    </div>
  </div>

  <AdminSiteSocialSection socialCustomLimit={socialCustomLimit} />
</fieldset>
