---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BitCard from './BitCard.astro';
import BitDialog from './BitDialog.astro';
import TagFilterHeader from './TagFilterHeader.astro';
import Lightbox from './Lightbox.astro';
import '../styles/bits-page.css';
import { getBitsDerivedText, type BitsEntry, type BitsYearOption } from '../lib/bits';
import { containsMarkdownMath } from '../lib/markdown-math';
import {
  MARKDOWN_MATH_STYLESHEET_DATA_ATTR,
  MARKDOWN_MATH_STYLESHEET_HREF,
  MARKDOWN_MATH_STYLESHEET_ID
} from '../lib/markdown-math-styles';
import { getThemeSettings } from '../lib/theme-settings';
import { createWithBase, joinPageSubtitleText } from '../utils/format';
import { collectTagScopedSummary, type TagSummary } from '../lib/tags';

const { items, resultCount, yearOptions = [] } = Astro.props as {
  items: BitsEntry[];
  resultCount: number;
  yearOptions?: BitsYearOption[];
};

const {
  settings: {
    page
  }
} = getThemeSettings();

import { PAGE_SIZE_BITS } from '../../site.config.mjs';

const base = import.meta.env.BASE_URL ?? '/';
const withBase = createWithBase(base);
const pageTitleText = page.bits.title || '动态';
// /bits/ 的标签入口走统一 dialog，作用域就是 bits 自身。
const tagOptions: TagSummary[] = collectTagScopedSummary(
  'all',
  items,
  (entry) => entry.data.tags
);
const subtitleText = joinPageSubtitleText(page.bits.subtitle, `共 ${resultCount} 条动态`);
const pageDescription = joinPageSubtitleText(
  `${pageTitleText}列表`,
  page.bits.subtitle,
  `共 ${resultCount} 条动态`
) ?? `${pageTitleText}列表`;
const priorityMediaBitId = items.find((bit) => (bit.data.images?.length ?? 0) > 0)?.id ?? null;

// 卡片按长短文本决定渲染完整正文还是摘要，弹窗始终渲染完整正文，因此每条都要 render。
const cards = await Promise.all(
  items.map(async (bit) => {
    const derivedText = getBitsDerivedText(bit);
    const { Content } = await render(bit);
    return {
      bit,
      excerpt: derivedText.excerpt,
      Content,
      hasMath: containsMarkdownMath(bit.body ?? '')
    };
  })
);
const hasRenderedMath = cards.some((card) => card.hasMath);
const katexStylesheetAttrs = { [MARKDOWN_MATH_STYLESHEET_DATA_ATTR]: 'true' };
---

<BaseLayout title={pageTitleText} description={pageDescription}>
  {hasRenderedMath ? (
    <link
      slot="head"
      id={MARKDOWN_MATH_STYLESHEET_ID}
      rel="stylesheet"
      href={MARKDOWN_MATH_STYLESHEET_HREF}
      {...katexStylesheetAttrs}
    />
  ) : null}

  <div
    class="entry-filters bits-filters"
    data-entry-filters
    data-index-url="/bits/index.json"
    data-page-size={String(PAGE_SIZE_BITS)}
  >
    <TagFilterHeader
      pageTitleText={pageTitleText}
      subtitleText={subtitleText}
      rssHref={withBase('/blog/rss.xml')}
      pickerHref="#bits-list"
      fallbackListId="bits-list"
      dialogTitleId="bits-tag-dialog-title"
      searchAriaLabel={`搜索${pageTitleText}动态`}
      showSearch={false}
      showRss={page.listRss.enabled !== false && page.listRss.bits !== false}
      tagOptions={tagOptions}
    />
  </div>

  <div class="bits-toolbar">
    <div class="bits-controls">
      {/*
        年份胶囊，交互见 scripts/bits-year-filter.ts。它只声明年份，
        可见集合仍由 entry-search 统一计算；样式复用归档页的一级胶囊。
      */}
      {yearOptions.length > 0 ? (
        <div
          class="scope-pills bits-year-filter"
          data-bits-year-bar
          role="group"
          aria-label={`按年份筛选${pageTitleText}`}
        >
          <span class="scope-pills__cursor" data-bits-year-cursor aria-hidden="true"></span>
          <button
            class="scope-pills__item is-active"
            type="button"
            data-bits-year-item
            data-bits-year=""
            aria-label={`显示全部${pageTitleText}`}
            aria-pressed="true"
          >
            全部
          </button>
          {yearOptions.map((option) => (
            <button
              class="scope-pills__item"
              type="button"
              data-bits-year-item
              data-bits-year={String(option.value)}
              aria-label={`筛选 ${option.value} 年${pageTitleText}，共 ${option.count} 条`}
              aria-pressed="false"
            >
              {option.value}
            </button>
          ))}
        </div>
      ) : null}
      <div class="bits-controls__actions">
        <div class="bits-controls__search-cluster">
          <form class="bits-search" role="search" data-bits-search-form data-bits-client-control>
            <label class="sr-only" for="bits-search">搜索动态</label>
            <input
              id="bits-search"
              type="search"
              placeholder="搜索：关键词 / 标签"
              autocomplete="off"
              enterkeyhint="search"
              aria-controls="bits-search-results-panel"
            />
            <button class="bits-search-btn" id="bits-search-btn" type="submit" aria-controls="bits-search-results-panel">
              搜索
            </button>
          </form>
        </div>
      </div>
    </div>
    <div class="bits-status" id="bits-search-status"></div>
    <p class="sr-only" id="bits-search-live" role="status" aria-live="polite" aria-atomic="true"></p>
  </div>

  <div data-bits-browse>
    <div id="bits-list">
      {cards.map(({ bit, excerpt, Content }) => (
        <BitCard bit={bit} excerpt={excerpt} Content={Content} prioritizeLeadMedia={bit.id === priorityMediaBitId} />
      ))}
    </div>

    <nav class="pagination" data-entry-pagination hidden aria-label={`${pageTitleText}分页`}>
      <div class="pagination__inner" data-entry-pagination-inner></div>
    </nav>

    {cards.map(({ bit, Content }) => (
      <BitDialog bit={bit} Content={Content} />
    ))}
  </div>

  <section
    id="bits-search-results-panel"
    class="bits-search-results"
    data-bits-search-results
    hidden
    aria-label="搜索结果"
  >
    <div class="bits-search-results__header">
      <p class="bits-search-results__summary" data-bits-search-results-summary role="status" aria-live="polite">搜索结果</p>
      <button class="bits-search-results__clear" type="button" data-bits-search-clear>重置筛选</button>
    </div>
    <div class="bits-search-results__list" data-bits-search-results-list></div>
  </section>

  <noscript>
    <style>
      [data-bits-client-control] {
        display: none !important;
      }
    </style>
    <p class="bits-noscript-note">搜索功能需要 JavaScript，当前仅保留列表浏览。</p>
  </noscript>

  <Lightbox
    id="lightbox"
    label="图片预览"
    enableZoom={true}
    enablePan={true}
    enableSwipeDownClose={true}
    mobileNav="hidden"
    mobileCount="hidden"
  />

  <script>
    // 求值顺序：entry-search 需先注册 entry-search:set-year 监听，
    // bits-year-filter 最后求值并广播初始年份。
    import '../scripts/entry-search.ts';
    import '../scripts/bits-search.ts';
    import '../scripts/bits-year-filter.ts';
    import '../scripts/bits-lightbox.ts';
    import '../scripts/bits-dialog.ts';
  </script>
</BaseLayout>
